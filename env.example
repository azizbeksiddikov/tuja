# Tuja configuration: names only, no values. Copy to the server's env file and fill in.
# Only DATABASE_URL (or POSTGRES_PASSWORD with docker-compose.prod.yml) and BETTER_AUTH_SECRET are required.

# --- Database ---
# docker-compose.prod.yml builds DATABASE_URL from this; use a URL-safe value (letters/digits).
POSTGRES_PASSWORD=
# Only when running without docker-compose.prod.yml:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# --- Auth ---
# 32+ random chars, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://tuja.azbek.me
BETTER_AUTH_URL=

# --- Branding ---
APP_NAME=Tuja
NEXT_PUBLIC_APP_NAME=Tuja

# --- AI (optional: without it the assistant shows "AI not configured") ---
GEMINI_API_KEY=
# Default gemini-3.6-flash; fallback used on timeouts/5xx (empty string disables)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# MINIMAL | LOW | MEDIUM | HIGH (default LOW)
GEMINI_THINKING=
USER_DAILY_MESSAGES=30
DEMO_DAILY_MESSAGES=300

# --- Plaid (optional: without it the "Link a bank" button is hidden) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# AES-256-GCM key for Plaid access tokens (64 hex chars). Falls back to a key derived from BETTER_AUTH_SECRET.
ENCRYPTION_KEY=

# --- Container ---
# Set to 0 to skip the demo seed on start
SEED_ON_START=1
